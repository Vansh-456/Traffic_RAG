# =====================================================================
# Delhi Traffic Copilot — environment configuration
# Copy to `.env` and fill in. Every variable is optional unless marked
# REQUIRED; features whose keys are missing are disabled gracefully.
# =====================================================================

# ---------- App ----------
APP_ENV=development                      # development | production | test
APP_BASE_URL=http://localhost:8000       # public URL of the API
FRONTEND_URL=http://localhost:3000       # used for CORS + links in alerts
ADMIN_TOKEN=change-me-admin-token        # REQUIRED in production: protects /api/admin/*
TIMEZONE=Asia/Kolkata                    # all relative dates resolve in this tz
LOG_LEVEL=INFO
MAX_QUERY_CHARS=1000                     # input length limit for chat messages
DATA_DIR=/data                           # raw download cache root (data/raw inside it)
USER_AGENT=DelhiTrafficCopilot/0.1 (+https://github.com/Vansh-456/Traffic_RAG)
CRAWL_DELAY_SECONDS=2.0                  # min delay between requests to the same domain

# ---------- Build (slow networks) ----------
APT_MIRROR=                              # e.g. http://mirrors.aliyun.com/debian (apt still verifies GPG signatures)
PIP_INDEX_URL=https://pypi.org/simple    # Python package index used inside the backend image
INSTALL_LOCAL_ML=0                       # 1 = bake torch + bge-m3 / bge-reranker into the backend image

# ---------- Datastores ----------
DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot   # REQUIRED
REDIS_URL=redis://redis:6379/0                                       # REQUIRED
DB_HOST_PORT=5433                        # host port for the compose Postgres (avoid clashing with a local 5432)
REDIS_HOST_PORT=6380                     # host port for the compose Redis

# ---------- LLM (LiteLLM) ----------
LLM_PROVIDER=groq                         # groq | anthropic | openai | gemini | ollama (informational; model strings carry the provider)
LLM_MODEL_ANSWER=groq/openai/gpt-oss-120b # strong model: answer generation
LLM_MODEL_FAST=groq/llama-3.1-8b-instant  # cheap model: enrichment, rewriting, verification
LLM_MODEL_FALLBACK=gemini/gemini-2.0-flash  # used when primary fails / circuit open
LLM_RPM_LIMIT=28                          # per-model requests/minute cap (Groq free tier = 30)
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=hash                  # local (bge-m3, needs local-ml image) | api | hash (lightweight dev fallback)
EMBEDDING_MODEL=BAAI/bge-m3              # for api provider: a LiteLLM embedding model, e.g. gemini/text-embedding-004
EMBEDDING_API_KEY=                       # optional; falls back to provider key env vars
EMBEDDING_DIM=1024                       # vectors are padded/truncated to this dim

# ---------- Reranker ----------
RERANKER_PROVIDER=lexical                # local (bge-reranker-v2-m3) | cohere | lexical (lightweight fallback)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=

# ---------- TomTom ----------
TOMTOM_API_KEY=                          # live flow + incidents disabled when empty
TOMTOM_DAILY_BUDGET=2300                 # hard cap on non-tile requests per IST day
NEXT_PUBLIC_TOMTOM_TILES_KEY=            # optional: frontend traffic tile overlay (restrict by domain!)

# ---------- News ----------
NEWS_QUERIES=delhi traffic advisory,delhi traffic diversion,delhi road closed,delhi waterlogging,delhi traffic jam,delhi accident road,दिल्ली ट्रैफिक,दिल्ली जाम
EXTRA_RSS_FEEDS=                         # comma-separated RSS URLs (Delhi city sections)
ENABLE_GDELT_BACKFILL=false
NEWS_FULLTEXT=true                       # fetch article bodies with trafilatura when robots.txt allows

# ---------- Geo ----------
NOMINATIM_ENABLED=false                  # geocoding fallback (rate-limited, cached)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=                                # optional routing for check_route corridors (e.g. https://router.project-osrm.org)

# ---------- Observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Alerts ----------
VAPID_PUBLIC_KEY=                        # generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
RESEND_API_KEY=                          # email via Resend (preferred) ...
SMTP_HOST=                               # ... or SMTP
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Delhi Traffic Copilot <alerts@example.com>
ALERT_CORRIDOR_METERS=300
ALERT_CONGESTION_RATIO=0.5               # alert if current/free-flow speed below this before departure

# ---------- RAG tuning ----------
CACHE_SIM_THRESHOLD=0.95
DEDUP_SIM_THRESHOLD=0.92
RELEVANCE_THRESHOLD=0.15                 # calibrate with `eval run`
RATE_LIMIT_PER_MIN=20                    # per-IP chat requests/minute
RETRIEVAL_TOP_K=8
RERANK_CANDIDATES=40

# ---------- Evaluation ----------
EVAL_DATABASE_URL=                       # isolated DB for eval fixtures; default: DATABASE_URL with db 'copilot_eval'
EVAL_REGRESSION_MARGIN=0.05              # CI gate: max allowed drop vs baseline for faithfulness / Recall@10
PUBLISH_EVENTS=true                      # Redis pub/sub of new chunks (eval runs force false)

# ---------- Retention ----------
RAW_RETENTION_DAYS=60
FLOW_DOWNSAMPLE_AFTER_DAYS=30

# ---------- Scheduler (cron strings, Asia/Kolkata) ----------
SCHEDULE_DTP=*/30 * * * *
SCHEDULE_NEWS=*/30 * * * *
SCHEDULE_RSS=*/30 * * * *
SCHEDULE_TOMTOM_TICK=*/5 * * * *         # tick; budget manager decides whether to poll
SCHEDULE_WEATHER=0 * * * *
SCHEDULE_GAZETTEER=0 4 1 * *
SCHEDULE_EXPIRE=*/15 * * * *
SCHEDULE_ALERTS=*/5 * * * *
SCHEDULE_RETENTION=0 3 * * *
SCHEDULE_EVAL=0 4 * * *

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
