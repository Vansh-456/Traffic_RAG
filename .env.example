# =====================================================================
# Delhi Traffic Copilot — environment configuration
# Copy to `.env` and fill in. Every variable is optional unless marked
# REQUIRED; features whose keys are missing are disabled gracefully.
# =====================================================================

# ---------- App ----------
# development | production | test
APP_ENV=development
# public URL of the API
APP_BASE_URL=http://localhost:8000
# used for CORS + links in alerts
FRONTEND_URL=http://localhost:3000
# REQUIRED in production: protects /api/admin/*
ADMIN_TOKEN=change-me-admin-token
# all relative dates resolve in this tz
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# input length limit for chat messages
MAX_QUERY_CHARS=1000
# raw download cache root (data/raw inside it)
DATA_DIR=/data
USER_AGENT=DelhiTrafficCopilot/0.1 (+https://github.com/Vansh-456/Traffic_RAG)
# min delay between requests to the same domain
CRAWL_DELAY_SECONDS=2.0

# ---------- Build (slow networks) ----------
# e.g. http://mirrors.aliyun.com/debian (apt still verifies GPG signatures)
APT_MIRROR=
# Python package index used inside the backend image
PIP_INDEX_URL=https://pypi.org/simple
# 1 = bake torch + bge-m3 / bge-reranker into the backend image
INSTALL_LOCAL_ML=0

# ---------- Datastores ----------
# REQUIRED
DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot
# REQUIRED
REDIS_URL=redis://redis:6379/0
# host port for the compose Postgres (avoid clashing with a local 5432)
DB_HOST_PORT=5433
# host port for the compose Redis
REDIS_HOST_PORT=6380

# ---------- LLM (LiteLLM) ----------
# groq | anthropic | openai | gemini | ollama (informational; model strings carry the provider)
LLM_PROVIDER=groq
# strong model: answer generation
LLM_MODEL_ANSWER=groq/openai/gpt-oss-120b
# cheap model: enrichment, rewriting, verification
LLM_MODEL_FAST=groq/openai/gpt-oss-20b
# used when primary fails / circuit open
LLM_MODEL_FALLBACK=gemini/gemini-3.5-flash
# gpt-oss reasoning budget: low | medium | high
LLM_REASONING_EFFORT=low
# per-model requests/minute cap (Groq free tier = 30)
# tool routing + claim verification: a separate Groq quota pool from LLM_MODEL_FAST
LLM_MODEL_VERIFY=groq/qwen/qwen3.8-27b
LLM_RPM_LIMIT=28
# worker/ingestion share of the RPM window; chat always keeps the rest
LLM_RPM_LIMIT_BACKGROUND=12
# tokens/minute per Groq model (free tier: 8,000)
LLM_TPM_LIMIT=7500
# if a model needs longer than this to free token budget, use the fallback model immediately
LLM_MAX_QUEUE_SECONDS=2.5
# one strict regeneration when >30% of claims are unsupported (costs ~2x tokens;
# false on free tiers keeps only the hedged/trimmed revision)
REGENERATE_UNSUPPORTED=true
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
# local (bge-m3, needs local-ml image) | api | hash (lightweight dev fallback)
EMBEDDING_PROVIDER=hash
# for api provider: a LiteLLM embedding model, e.g. gemini/text-embedding-004
EMBEDDING_MODEL=BAAI/bge-m3
# optional; falls back to provider key env vars
EMBEDDING_API_KEY=
# vectors are padded/truncated to this dim
EMBEDDING_DIM=1024

# ---------- Reranker ----------
# local (bge-reranker-v2-m3) | cohere | lexical (lightweight fallback)
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=

# ---------- TomTom ----------
# live flow + incidents disabled when empty
TOMTOM_API_KEY=
# hard cap on non-tile requests per IST day
TOMTOM_DAILY_BUDGET=2300
# optional: frontend traffic tile overlay (restrict by domain!)
NEXT_PUBLIC_TOMTOM_TILES_KEY=

# ---------- News ----------
NEWS_QUERIES=delhi traffic advisory,delhi traffic diversion,delhi road closed,delhi waterlogging,delhi traffic jam,delhi accident road,दिल्ली ट्रैफिक,दिल्ली जाम
# comma-separated RSS URLs (Delhi city sections)
EXTRA_RSS_FEEDS=
ENABLE_GDELT_BACKFILL=false
# fetch article bodies with trafilatura when robots.txt allows
NEWS_FULLTEXT=true

# ---------- Geo ----------
# geocoding fallback (rate-limited, cached)
NOMINATIM_ENABLED=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# optional routing for check_route corridors (e.g. https://router.project-osrm.org)
OSRM_URL=

# ---------- Observability ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Alerts ----------
# generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# email via Resend (preferred) ...
RESEND_API_KEY=
# ... or SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Delhi Traffic Copilot <alerts@example.com>
ALERT_CORRIDOR_METERS=300
# alert if current/free-flow speed below this before departure
ALERT_CONGESTION_RATIO=0.5

# ---------- RAG tuning ----------
CACHE_SIM_THRESHOLD=0.95
DEDUP_SIM_THRESHOLD=0.92
# calibrated via `copilot eval run` threshold_sweep (re-run when changing reranker)
RELEVANCE_THRESHOLD=0.08
# per-IP chat requests/minute
RATE_LIMIT_PER_MIN=20
RETRIEVAL_TOP_K=8
RERANK_CANDIDATES=40

# ---------- Evaluation ----------
# isolated DB for eval fixtures; default: DATABASE_URL with db 'copilot_eval'
EVAL_DATABASE_URL=
# CI gate: max allowed drop vs baseline for faithfulness / Recall@10
EVAL_REGRESSION_MARGIN=0.05
# Redis pub/sub of new chunks (eval runs force false)
PUBLISH_EVENTS=true

# ---------- Retention ----------
RAW_RETENTION_DAYS=60
FLOW_DOWNSAMPLE_AFTER_DAYS=30

# ---------- Scheduler (cron strings, Asia/Kolkata) ----------
SCHEDULE_DTP=*/30 * * * *
SCHEDULE_NEWS=*/30 * * * *
SCHEDULE_RSS=*/30 * * * *
# tick; budget manager decides whether to poll
SCHEDULE_TOMTOM_TICK=*/5 * * * *
SCHEDULE_WEATHER=0 * * * *
SCHEDULE_GAZETTEER=0 4 1 * *
SCHEDULE_EXPIRE=*/15 * * * *
SCHEDULE_ALERTS=*/5 * * * *
SCHEDULE_RETENTION=0 3 * * *
SCHEDULE_EVAL=0 4 * * *

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
